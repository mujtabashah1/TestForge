{
  "name": "@testforge/automation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:integration": "playwright test --project=integration",
    "test:ui": "playwright test --project=chromium",
    "test:e2e": "playwright test --project=e2e-chromium",
    "test:regression": "playwright test --project=chromium --project=e2e-chromium --project=firefox --project=webkit --project=mobile-chromium",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "report": "allure generate allure-results --clean -o allure-report"
  },
  "dependencies": {
    "@faker-js/faker": "^10.1.0",
    "@playwright/test": "^1.56.1",
    "@prisma/client": "^6.18.0",
    "allure-playwright": "^3.4.2",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "allure-commandline": "^2.34.1",
    "typescript": "^5.9.3"
  }
}
