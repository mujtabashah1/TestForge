{
  "name": "testforge",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise test automation portfolio with a real e-commerce AUT",
  "workspaces": [
    "app/backend",
    "app/frontend",
    "automation"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @testforge/backend\" \"npm run dev -w @testforge/frontend\"",
    "db:generate": "npm run db:generate -w @testforge/backend",
    "db:migrate": "npm run db:migrate -w @testforge/backend",
    "db:seed": "npm run db:seed -w @testforge/backend",
    "db:local": "node scripts/local-postgres.mjs",
    "test": "npm run test -w @testforge/automation",
    "test:api": "npm run test:api -w @testforge/automation",
    "test:integration": "npm run test:integration -w @testforge/automation",
    "test:ui": "npm run test:ui -w @testforge/automation",
    "test:e2e": "npm run test:e2e -w @testforge/automation",
    "report": "npm run report -w @testforge/automation"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "concurrently": "^9.2.1",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "wait-on": "^9.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
